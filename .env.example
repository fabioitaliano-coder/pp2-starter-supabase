# Copiá este archivo como .env y completá los valores. El .env NUNCA se sube a GitHub.
# Supabase > Project Settings > API Keys (o botón "Connect" del proyecto).

# --- PÚBLICAS: viajan en el bundle del navegador (prefijo VITE_). ---
# Project URL, ej: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Clave "publishable" (empieza con sb_publishable_). En proyectos viejos: "anon".
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- PRIVADA: SOLO para los scripts de scripts/ en tu máquina. ---
# Clave "secret" (empieza con sb_secret_). En proyectos viejos: "service_role".
# Saltea RLS. NUNCA con prefijo VITE_, NUNCA en Render/Vercel, NUNCA en Git.
SUPABASE_SECRET_KEY=

# --- OPCIONAL: prueba del alta pública en test:rls ---
# Un email tuyo con alias (nombre@gmail.com -> nombre+rls@gmail.com). Supabase rechaza
# dominios inventados y enviará un mail de confirmación a esa casilla.
TEST_SIGNUP_EMAIL=
